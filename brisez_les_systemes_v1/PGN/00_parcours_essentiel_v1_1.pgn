[Event "V1.1 pédagogique / B1 — Pilotage automatique / Sans c3 : développer avec ...Bg4"]
[Site "Cours Chessable francophone — parcours essentiel"]
[Date "2026.07.13"]
[Round "P11-01-ORD-01"]
[White "Réponse système"]
[Black "Répertoire anti-systèmes"]
